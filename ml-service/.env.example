# Gamification ML service (Flask, difficulty prediction)

# Guards the /retrain endpoint. Read by app.py - without it, anyone who can
# reach the port can retrain the model.
RETRAIN_SECRET=

# Port. 5000 is the default in app.py and what the backend's ML_SERVICE_URL
# points at. On macOS 5000 is taken by AirPlay Receiver; move it there.
PORT=5000
