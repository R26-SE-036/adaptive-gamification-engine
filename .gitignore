# Dependencies
node_modules/

# Environment Variables & Secrets (CRITICAL)
.env
backend/.env
ml-service/.env
**/.env

# Python specific
# Virtualenvs. Both spellings, and any depth: a venv is machine-specific
# (its launcher scripts hardcode absolute paths, so a committed one is broken
# the moment anyone checks it out somewhere else) and it dwarfs the real
# source - 339 files against 2 in one careless `git add -A`.
.venv/
venv/
**/.venv/
**/venv/
__pycache__/
*.pyc
*.pkl
ml-service/__pycache__/
ml-service/*.pkl

# ...except the one the ML service exists to serve. Without model.pkl in the
# checkout, /predict answers 500 "Model not trained yet" and the backend falls
# through to its heuristic - which is what happened for the whole project, so
# the Random Forest never actually ran. Both this rule and ml-service/.gitignore
# excluded it; a negation is needed in each, because git applies the nested file
# too and a re-include in only one of them still leaves the file ignored.
!ml-service/model.pkl

# Build outputs
dist/
build/
frontend/dist/

# System files
.DS_Store
