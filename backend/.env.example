# ============================================================================
# REFERENCE, NOT A REPLACEMENT.
#
# This file lists every setting this service understands - the ones it always
# had, plus the ones added for Code Guru integration.
#
# If you ALREADY have a .env, do not copy this over it: your .env holds real
# credentials that exist nowhere else. Compare the two and add only the keys
# you are missing. Copy the whole file only if you have no .env at all.
# ============================================================================

# ── Code Coach: the platform's identity provider ──
# Every request to this service carries a Code Coach access token, and this
# backend verifies it by calling Code Coach. Nothing works without this set.
# Mode A (local):      http://127.0.0.1:8000
# Mode B (Cloudflare): the shared tunnel URL
CODE_COACH_URL=http://127.0.0.1:8000
CODE_COACH_TIMEOUT_MS=10000

# Seconds*1000 a verified token is trusted before re-checking with Code Coach.
AUTH_CACHE_TTL_MS=60000

# ── This service ──
# 3002, not 3000: PairPath's frontend is on 3000 and its API on 3001.
PORT=3002

# Browser origins allowed to call this API: the gamification frontend and the
# Code Guru portal.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ── MongoDB (this service's own data: games, questions, player profiles) ──
MONGODB_URI=mongodb://localhost:27017/adaptive_gamification

# ── Flask ML service (difficulty prediction) ──
# The Random Forest that picks a difficulty. If this is unreachable the engine
# still serves games, but difficulty comes from the pre-ML heuristic instead -
# services/difficultyService.js logs a warning and marks the response
# source: 'heuristic' whenever that happens, so check the logs before believing
# a demo is showing adaptive behaviour.
ML_SERVICE_URL=http://127.0.0.1:5000
FLASK_ML_URL=http://127.0.0.1:5000

# How long to wait for a prediction before falling back.
ML_TIMEOUT_MS=5000

# NOTE: there is deliberately no JWT_SECRET here. This service does not issue or
# verify tokens itself - Code Coach does. If you find code reaching for a shared
# signing secret, it is a leftover.

# ── Optional: DNS override (PER-DEVELOPER) ──
# Only needed where Node cannot read the system DNS config and falls back to
# 127.0.0.1, which makes every mongodb+srv:// lookup fail with
# querySrv ECONNREFUSED while the rest of the machine resolves names fine.
# Point it at a resolver that works (your router, or 8.8.8.8). Leave unset
# otherwise.
# DNS_SERVERS=192.168.1.1

# ============================ ML SERVICE (backend/ml) ============================
# Flask, difficulty prediction. It reads this same file: the ML code lives under
# backend/ml and shares this service's database, so a second .env beside it was
# one more place for the connection string to drift out of step.

# Guards POST /retrain. Read by ml/app.py - without it, anyone who can reach the
# port can refit the model. Unset means the endpoint refuses everyone.
RETRAIN_SECRET=

# The ML service's own port. NOT the PORT above, which is the Node API's - both
# processes read this file, so compose overrides PORT for the ML container.
# On macOS 5000 is taken by AirPlay Receiver; move it there.
ML_PORT=5000

# ── Study Guider (the Progress Tracker) ──
# FR-12: this engine transmits a summary of every completed round there. The
# student's own token is forwarded, so Study Guider authenticates it the same
# way it authenticates everything else - there is no service account.
STUDY_GUIDER_URL=http://127.0.0.1:8010
STUDY_GUIDER_TIMEOUT_MS=5000

# Set to `off` to stop transmitting. Deliberately an explicit switch rather than
# "unset the URL": a missing URL means "use the default", and a silent stop is
# the exact failure FR-12 was suffering from before.
STUDY_GUIDER_SUMMARIES=on

# ── Rule configuration (FR-15) ──
# Gates GET/PUT/DELETE /api/v1/gamification/rules, which change the engine's
# thresholds without a redeploy. Unset means those endpoints refuse everyone -
# defaulting to open would put the scoring under the control of anyone who can
# reach the port.
#
# The platform is student-only, so there is no admin ROLE to check. Whoever
# holds this secret is the operator, which is the only party the system can
# actually distinguish.
RULE_CONFIG_SECRET=

# How long a threshold snapshot is trusted before a read triggers a background
# reload. A change takes effect within this window rather than instantly.
RULE_CONFIG_TTL_MS=30000

# ── Cross-service integration tests (npm run test:integration) ──
# These play real rounds against live Code Coach, Study Guider and this engine,
# so they need a real student to act as. Rounds are marked dataSource=test and
# are dropped by the trainer.
#
# Leave these unset and the suite skips by name rather than passing silently.
INTEGRATION_STUDENT_EMAIL=
INTEGRATION_STUDENT_PASSWORD=
# Any of the fourteen concept tags. Defaults to loop_boundaries.
INTEGRATION_CONCEPT=loop_boundaries
