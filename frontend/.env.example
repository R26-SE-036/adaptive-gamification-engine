# ── Code Coach: the platform's identity provider ──
# The frontend calls Code Coach through a Vite proxy (see vite.config.js), which
# keeps the browser same-origin and avoids CORS entirely.
#
# VITE_CODE_COACH_ORIGIN is where the proxy forwards to.
#   Mode A (local):      http://127.0.0.1:8000
#   Mode B (Cloudflare): the shared tunnel URL
VITE_CODE_COACH_ORIGIN=http://127.0.0.1:8000

# The path the app calls. Leave as-is; it is the proxy prefix, not a real host.
VITE_CODE_COACH_API_URL=/code-coach-api/api/v1

# ── This service's own backend (games, questions, player profiles) ──
# 3002, not 3000 - PairPath's frontend owns 3000 and its API owns 3001.
VITE_GAMIFICATION_API_URL=http://localhost:3002/api/v1

# ── The shared Code Guru portal ──
# A student with no session is sent here to sign in and comes back with the
# session in the URL fragment.
VITE_PORTAL_URL=http://localhost:4200

# Renders this app's own localhost-only login form instead of redirecting to the
# portal. Ignored unless the page is served from localhost. Leave unset in any
# deployed build.
VITE_ENABLE_DEV_LOGIN=true
